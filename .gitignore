# Whitelist: ignore everything except the source code and project files.

/*
# Project files (keep tracked)
!.gitignore
!Cargo.toml
!Cargo.lock
!rustfmt.toml
!LICENSE
!README.md
!CHANGELOG.md
!REFACTORING_PLAYBOOK.md
!REMINDERS.md
# Source code
!/src/
!/vendor/
!/docs/
/docs/*
!/docs/chromium_flags.yml.example

# Secrets / local config (never commit, even if un-ignored later)
client.yml
.env
.spotify_token_cache.json
.cached_device_id.txt
*.rs.bk
# Editor / temp junk
*.swp
*.swo
tags
.idea
.vscode
